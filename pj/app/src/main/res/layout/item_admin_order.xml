<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/order_id_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mã: ORD001"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/order_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏳ Chờ xử lý"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/status_pending_bg" />
        </LinearLayout>

        <TextView
            android:id="@+id/order_customer_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👤 Nguyễn Văn A"
            android:textSize="14sp"
            android:textColor="#424242"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/order_address_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 123 Đường ABC, Q1, HCM"
            android:textSize="13sp"
            android:textColor="#616161"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/order_date_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📅 24/11/2025"
            android:textSize="13sp"
            android:textColor="#757575"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/order_amount_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="450,000₫"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/amber_700"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btn_change_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔄 Thay đổi trạng thái"
            android:textColor="@color/white"
            android:backgroundTint="@color/amber_600"
            android:layout_marginTop="12dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>

