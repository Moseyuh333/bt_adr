<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Book Image -->
            <ImageView
                android:id="@+id/detail_book_image"
                android:layout_width="200dp"
                android:layout_height="300dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:scaleType="centerCrop"
                android:contentDescription="Book Cover" />

            <!-- Book Title -->
            <TextView
                android:id="@+id/detail_book_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Book Title"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Author -->
            <TextView
                android:id="@+id/detail_book_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="By Author"
                android:textSize="16sp"
                android:textColor="#FF9800"
                android:layout_marginBottom="8dp" />

            <!-- Category and Publisher -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/detail_book_category"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Category: Fiction"
                    android:textSize="14sp"
                    android:textColor="#757575" />

                <TextView
                    android:id="@+id/detail_shop_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📚 BookStore"
                    android:textSize="13sp"
                    android:textColor="#4CAF50"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Rating and Sold Count -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"
                android:background="#F5F5F5"
                android:padding="12dp">

                <RatingBar
                    android:id="@+id/detail_rating_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:numStars="5"
                    android:rating="4.5"
                    android:isIndicator="true"
                    style="?android:attr/ratingBarStyleSmall"
                    android:scaleX="1.2"
                    android:scaleY="1.2" />

                <TextView
                    android:id="@+id/detail_rating_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.5"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:id="@+id/detail_reviews_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="(1200 đánh giá)"
                    android:textSize="14sp"
                    android:textColor="#666"
                    android:layout_marginStart="4dp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:background="#CCC"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/detail_sold_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đã bán 500"
                    android:textSize="14sp"
                    android:textColor="#666" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginBottom="12dp" />

            <!-- Price Section with Discount -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/detail_book_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="89,000₫"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#FF6F00" />

                <TextView
                    android:id="@+id/detail_original_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="120,000₫"
                    android:textSize="16sp"
                    android:textColor="#999"
                    android:layout_marginStart="12dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/detail_discount_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-20%"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#D32F2F"
                    android:background="#FFEB3B"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginStart="8dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Description -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/detail_book_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This is a detailed description of the book..."
                android:textSize="14sp"
                android:textColor="#424242"
                android:layout_marginBottom="16dp"
                android:lineSpacingExtra="4dp" />

            <!-- Stock Availability -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:padding="12dp"
                android:background="#F5F5F5">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tình trạng kho:"
                    android:textSize="14sp"
                    android:textColor="#424242" />

                <TextView
                    android:id="@+id/stock_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Còn 100 cuốn"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#4CAF50" />
            </LinearLayout>

            <!-- Quantity Selection -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Số lượng"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/decrease_quantity_btn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="-"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:background="#E0E0E0"
                    android:textColor="#424242" />

                <TextView
                    android:id="@+id/quantity_text"
                    android:layout_width="80dp"
                    android:layout_height="48dp"
                    android:text="1"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="#FFFFFF"
                    android:textColor="#212121"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/increase_quantity_btn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="+"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:background="#FF6F00"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <!-- Customer Reviews Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Đánh giá khách hàng"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Rating Statistics Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:elevation="2dp"
                android:radius="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="#FAFAFA">

                    <!-- Overall Rating -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/overall_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4.5"
                            android:textSize="48sp"
                            android:textStyle="bold"
                            android:textColor="#FF6F00" />

                        <RatingBar
                            android:id="@+id/overall_rating_bar"
                            style="?android:attr/ratingBarStyleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:numStars="5"
                            android:rating="4.5"
                            android:isIndicator="true"
                            android:scaleX="1.2"
                            android:scaleY="1.2"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/total_reviews_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1,250 đánh giá"
                            android:textSize="12sp"
                            android:textColor="#666"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Rating Breakdown -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <!-- 5 Stars -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5⭐"
                                android:textSize="12sp"
                                android:minWidth="40dp" />

                            <ProgressBar
                                android:id="@+id/progress_5_star"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="0dp"
                                android:layout_height="8dp"
                                android:layout_weight="1"
                                android:progress="75"
                                android:max="100"
                                android:progressTint="#4CAF50" />

                            <TextView
                                android:id="@+id/count_5_star"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="75%"
                                android:textSize="11sp"
                                android:textColor="#666"
                                android:minWidth="35dp"
                                android:gravity="end"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>

                        <!-- 4 Stars -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4⭐"
                                android:textSize="12sp"
                                android:minWidth="40dp" />

                            <ProgressBar
                                android:id="@+id/progress_4_star"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="0dp"
                                android:layout_height="8dp"
                                android:layout_weight="1"
                                android:progress="18"
                                android:max="100"
                                android:progressTint="#8BC34A" />

                            <TextView
                                android:id="@+id/count_4_star"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="18%"
                                android:textSize="11sp"
                                android:textColor="#666"
                                android:minWidth="35dp"
                                android:gravity="end"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>

                        <!-- 3 Stars -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3⭐"
                                android:textSize="12sp"
                                android:minWidth="40dp" />

                            <ProgressBar
                                android:id="@+id/progress_3_star"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="0dp"
                                android:layout_height="8dp"
                                android:layout_weight="1"
                                android:progress="5"
                                android:max="100"
                                android:progressTint="#FFC107" />

                            <TextView
                                android:id="@+id/count_3_star"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5%"
                                android:textSize="11sp"
                                android:textColor="#666"
                                android:minWidth="35dp"
                                android:gravity="end"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>

                        <!-- 2 Stars -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2⭐"
                                android:textSize="12sp"
                                android:minWidth="40dp" />

                            <ProgressBar
                                android:id="@+id/progress_2_star"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="0dp"
                                android:layout_height="8dp"
                                android:layout_weight="1"
                                android:progress="2"
                                android:max="100"
                                android:progressTint="#FF9800" />

                            <TextView
                                android:id="@+id/count_2_star"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2%"
                                android:textSize="11sp"
                                android:textColor="#666"
                                android:minWidth="35dp"
                                android:gravity="end"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>

                        <!-- 1 Star -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1⭐"
                                android:textSize="12sp"
                                android:minWidth="40dp" />

                            <ProgressBar
                                android:id="@+id/progress_1_star"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="0dp"
                                android:layout_height="8dp"
                                android:layout_weight="1"
                                android:progress="0"
                                android:max="100"
                                android:progressTint="#F44336" />

                            <TextView
                                android:id="@+id/count_1_star"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0%"
                                android:textSize="11sp"
                                android:textColor="#666"
                                android:minWidth="35dp"
                                android:gravity="end"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Reviews List Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bình luận từ khách hàng"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/reviews_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="16dp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <!-- Related Products Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sản Phẩm Liên Quan"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/related_books_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:padding="8dp">

        <!-- Favorite Button -->
        <Button
            android:id="@+id/favorite_btn"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="❤️ Thêm vào yêu thích"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#424242"
            android:background="#F5F5F5"
            android:layout_marginBottom="8dp" />

        <!-- Add to Cart and Buy Now Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/add_to_cart_btn"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="🛒 Thêm Giỏ Hàng"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@color/amber_600"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/buy_now_btn"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="⚡ Mua Ngay"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@color/amber_600"
                android:layout_marginStart="4dp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>

